# Don't let Apache list folder contents if there's no index file
Options -Indexes

# Never serve these file types directly, no matter which folder they're in
<FilesMatch "\.(sql|md|log|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
